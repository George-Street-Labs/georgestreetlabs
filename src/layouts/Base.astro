---
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import privacy from '../data/privacy.json';

interface Props {
  title: string;
  description?: string;
  /** Skip the site header and footer entirely (standalone custom pages). */
  bare?: boolean;
  /** Extra markup injected into <head> — meta tags, analytics snippets, etc. */
  headHtml?: string;
  noindex?: boolean;
  /** Tell search engines not to follow any link on this page. */
  nofollow?: boolean;
}
const {
  title,
  description = site.seo.defaultDescription,
  bare = false,
  headHtml = '',
  noindex = false,
  nofollow = false,
} = Astro.props;

const robots = [noindex && 'noindex', nofollow && 'nofollow'].filter(Boolean).join(', ');

// A link can be new-tab, nofollow, both or neither; rel is the merge.
const relFor = (l: { newTab?: boolean; nofollow?: boolean }) =>
  [l.newTab && 'noopener noreferrer', l.nofollow && 'nofollow'].filter(Boolean).join(' ') || undefined;

// The nav is the merge of two sources, sorted together by "order":
//   1. Links typed into Site settings → Navigation (can point anywhere).
//   2. CMS pages with "Show in navigation" on, when "Include pages" is on.
const pageLinks = site.nav.includePages
  ? (await getCollection('pages'))
      .filter(p => p.data.visible && p.data.showInNav)
      .map(p => ({
        label: p.data.navLabel || p.data.title,
        url: `/${p.slug}/`,
        order: p.data.order,
        newTab: false,
      }))
  : [];

const navLinks = [...(site.nav.links ?? []), ...pageLinks]
  .filter(l => l.label && l.url)
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));

// The privacy directory adds itself to the footer, so turning the section on in
// the CMS is enough — no one has to remember to type the link in as well.
const privacyFooterLink =
  privacy.enabled !== false && privacy.footerLink?.show !== false
    ? [{
        label: privacy.footerLink?.label || 'Privacy',
        url: '/privacy/',
        order: privacy.footerLink?.order ?? 90,
        newTab: false,
        nofollow: privacy.footerLink?.nofollow !== false,
      }]
    : [];

const footerLinks = [...((site.footer.links ?? []) as any[]), ...privacyFooterLink]
  .filter(l => l.label && l.url)
  .sort((a, b) => (a.order ?? 50) - (b.order ?? 50));

const isCurrent = (url: string) => Astro.url.pathname === url;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="google-site-verification" content="m3FlIA3rzpCKdcAesvSamKjEafyIGHbErdSN7qLYfyk" />
<title>{title}</title>
<meta name="description" content={description}>
{robots && <meta name="robots" content={robots} />}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
:root{
  --ink:#15212f; --ink-soft:#3c4a5c; --porcelain:#f2f4f6; --paper:#fff;
  --sign-green:#0e7a4f; --sign-green-dark:#0a5c3c; --tape-amber:#e8a020;
  --line:#d6dce3; --proto-blue:#2660a4; --radius:14px;
  --font-display:"Bricolage Grotesque",system-ui,sans-serif;
  --font-body:"Inter",system-ui,sans-serif;
  --font-mono:"IBM Plex Mono",ui-monospace,monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}}
body{font-family:var(--font-body);color:var(--ink);background:var(--porcelain);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit}
img{max-width:100%}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
:focus-visible{outline:3px solid var(--tape-amber);outline-offset:2px;border-radius:4px}

nav.site-nav{position:sticky;top:0;z-index:50;background:rgba(242,244,246,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;height:64px;gap:16px}
.nav-brand{font-family:var(--font-mono);font-weight:600;font-size:14px;letter-spacing:.06em;text-decoration:none;display:flex;align-items:center;gap:10px;white-space:nowrap}
.nav-brand .dot{width:10px;height:10px;border-radius:3px;background:var(--sign-green);display:inline-block}
.nav-brand .brand-logo{height:24px;width:auto;border-radius:5px}
.nav-links{display:flex;gap:24px;font-size:14px;font-weight:500;flex-wrap:wrap;justify-content:flex-end}
.nav-links a{text-decoration:none;color:var(--ink-soft);white-space:nowrap}
.nav-links a:hover{color:var(--ink)}
.nav-links a[aria-current="page"]{color:var(--ink)}
@media(max-width:640px){.nav-links{gap:14px;font-size:13px}}

.eyebrow{font-family:var(--font-mono);font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--sign-green);margin-bottom:14px;display:flex;align-items:center;gap:12px}
.eyebrow::after{content:"";flex:1;max-width:80px;height:1px;background:var(--line)}
.section-title{font-family:var(--font-display);font-weight:700;font-size:clamp(26px,3.6vw,38px);letter-spacing:-.01em;margin-bottom:14px}

.btn{display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:15px;text-decoration:none;padding:13px 24px;border-radius:10px;transition:transform .15s ease,box-shadow .15s ease}
.btn-primary{background:var(--ink);color:#fff;box-shadow:0 4px 14px rgba(21,33,47,.25)}
.btn-primary:hover{transform:translateY(-2px)}
.btn-ghost{border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}
.btn-ghost:hover{border-color:var(--ink-soft)}

/* Shared by every inner page: CMS pages, privacy policies, the thank-you page. */
.page{padding:72px 0 88px}
.page h1{font-family:var(--font-display);font-weight:700;font-size:clamp(32px,4.6vw,48px);line-height:1.1;letter-spacing:-.015em;margin-bottom:14px;max-width:20ch}
.page .page-desc{font-size:18px;color:var(--ink-soft);max-width:56ch;margin-bottom:8px}
.prose{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:40px 44px;margin-top:34px;max-width:820px}
@media(max-width:640px){.prose{padding:26px 22px}}
.prose h2{font-family:var(--font-display);font-weight:700;font-size:24px;letter-spacing:-.01em;margin:34px 0 12px}
.prose h2:first-child{margin-top:0}
.prose h3{font-family:var(--font-display);font-weight:600;font-size:19px;margin:26px 0 10px}
.prose p{color:var(--ink-soft);margin-bottom:16px;font-size:15.5px}
.prose ul,.prose ol{margin:0 0 16px 22px;color:var(--ink-soft);font-size:15.5px}
.prose li{margin-bottom:6px}
.prose a{color:var(--sign-green-dark);font-weight:500}
.prose img{border-radius:10px;border:1px solid var(--line);margin:10px 0}
.prose blockquote{border-left:3px solid var(--sign-green);padding-left:18px;margin:20px 0;color:var(--ink-soft);font-style:italic}
.prose hr{border:none;border-top:1px solid var(--line);margin:28px 0}
.prose code{font-family:var(--font-mono);font-size:13.5px;background:var(--porcelain);padding:2px 6px;border-radius:5px}
.prose table{border-collapse:collapse;width:100%;margin:0 0 16px;font-size:14.5px;color:var(--ink-soft);display:block;overflow-x:auto}
.prose th,.prose td{border:1px solid var(--line);padding:8px 12px;text-align:left}
.prose th{background:var(--porcelain);color:var(--ink);font-weight:600}

footer{border-top:1px solid var(--line);padding:36px 0 48px;font-size:13px;color:var(--ink-soft)}
.foot-inner{display:flex;flex-wrap:wrap;gap:18px;justify-content:space-between;align-items:center}
.foot-inner .mono{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em}
.foot-links{display:flex;flex-wrap:wrap;gap:18px}
.foot-links a{text-decoration:none}
.foot-links a:hover{color:var(--ink)}
</style>
{headHtml && <Fragment set:html={headHtml} />}
</head>
<body>

{!bare && (
<nav class="site-nav">
  <div class="wrap nav-inner">
    <a class="nav-brand" href={site.brand.href || '/'}>
      {site.brand.logo
        ? <img class="brand-logo" src={site.brand.logo} alt="" />
        : site.brand.showDot && <span class="dot" aria-hidden="true"></span>}
      <span set:html={(site.brand.name || '').replace(/ /g, '&nbsp;')} />
    </a>
    <div class="nav-links">
      {navLinks.map(l => (
        <a
          href={l.url}
          target={l.newTab ? '_blank' : undefined}
          rel={relFor(l)}
          aria-current={isCurrent(l.url) ? 'page' : undefined}
        >{l.label}</a>
      ))}
    </div>
  </div>
</nav>
)}

<slot />

{!bare && (
<footer>
  <div class="wrap foot-inner">
    <div class="mono">{site.footer.monoLine}</div>
    {footerLinks.length > 0 && (
      <div class="foot-links">
        {footerLinks.map(l => (
          <a
            href={l.url}
            target={l.newTab ? '_blank' : undefined}
            rel={relFor(l)}
            aria-current={isCurrent(l.url) ? 'page' : undefined}
          >{l.label}</a>
        ))}
      </div>
    )}
    <div>{site.footer.copyright}</div>
  </div>
</footer>
)}

</body>
</html>
