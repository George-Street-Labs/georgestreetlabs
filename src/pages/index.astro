---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CustomSection from '../components/CustomSection.astro';
import ContactForm from '../components/ContactForm.astro';
import home from '../data/home.json';
import site from '../data/site.json';
import { md, mdInline } from '../lib/md';

const all = (await getCollection('products'))
  .filter(p => p.data.visible)
  .sort((a, b) => a.data.order - b.data.order);

const liveProducts = all.filter(p => p.data.live);
const bench = all.filter(p => !p.data.live);

const rendered = await Promise.all(
  liveProducts.map(async p => ({ ...p, Content: (await p.render()).Content }))
);
const benchRendered = await Promise.all(
  bench.map(async p => ({ ...p, Content: (await p.render()).Content }))
);

const stampClass = (s) =>
  s === 'Production' || s === 'Beta' ? 'production'
  : s === 'Prototype' ? 'prototype'
  : 'dev';

const hero = home.hero;

// Built-in sections and CMS-authored extra sections share one ordering space,
// so an extra section can be dropped anywhere on the page by its "order".
const blocks = [
  { kind: 'products', order: home.products.order ?? 10, visible: home.products.visible !== false },
  { kind: 'bench', order: home.bench.order ?? 20, visible: home.bench.visible !== false && benchRendered.length > 0 },
  { kind: 'about', order: home.about.order ?? 30, visible: home.about.visible !== false },
  { kind: 'contact', order: home.contact.order ?? 90, visible: home.contact.visible !== false },
  ...(home.customSections ?? []).map((s: any) => ({
    kind: 'custom', order: s.order ?? 50, visible: s.visible !== false, section: s,
  })),
]
  .filter(b => b.visible)
  .sort((a, b) => a.order - b.order);
---
<Base
  title={home.seo?.title || `George Street Labs — A product workshop`}
  description={home.seo?.description || site.seo.defaultDescription}
>

{hero.visible !== false && (
<header class="hero" id="top">
  <div class="wrap">
    {hero.showSign !== false && (
      <div class="street-sign" role="img" aria-label={`${hero.signMain} street sign`}>
        <div class="sign-main">{hero.signMain}<small>{(hero.signSub || '').replace(/ /g, ' ')}</small></div>
        {hero.signTab && <div class="sign-tab">{hero.signTab.replace(/ /g, ' ')}</div>}
      </div>
    )}
    <h1 set:html={mdInline(hero.headline)} />
    {hero.lede && <p class="lede" set:html={mdInline(hero.lede)} />}
    {(hero.ctas ?? []).length > 0 && (
      <div class="hero-ctas">
        {(hero.ctas ?? []).map((c: any) => (
          <a
            class={`btn ${c.style === 'ghost' ? 'btn-ghost' : 'btn-primary'}`}
            href={c.url}
            target={c.newTab ? '_blank' : undefined}
            rel={c.newTab ? 'noopener noreferrer' : undefined}
          >{c.label}</a>
        ))}
      </div>
    )}
  </div>
  {hero.coords && (
    <div class="hero-coords" aria-hidden="true" set:html={hero.coords.replace(/\n/g, '<br>')} />
  )}
</header>
)}

{blocks.map(b => (
  <Fragment>
    {b.kind === 'products' && (
      <section id="products">
        <div class="wrap">
          {home.products.eyebrow && <div class="eyebrow">{home.products.eyebrow}</div>}
          {home.products.title && <h2 class="section-title">{home.products.title}</h2>}
          {home.products.intro && <p class="section-intro" set:html={mdInline(home.products.intro)} />}

          {rendered.map(p => (
            <article class="product">
              <div class="file-no"><b>{String(p.data.order).padStart(2,'0')}</b>FILE {p.data.fileNo}</div>
              <div>
                <div class="title-row">
                  {p.data.logo && <img class="logo" src={p.data.logo} alt="" />}
                  <h3>{p.data.name}</h3>
                </div>
                <div class="tagline">{p.data.tagline}</div>
                <div class="desc"><p.Content /></div>
                {p.data.features.length > 0 && (
                  <ul class="feats">{p.data.features.map(f => <li>{f}</li>)}</ul>
                )}
                {(p.data.appStoreUrl || p.data.playStoreUrl) && (
                  <div class="store-ctas">
                    {p.data.appStoreUrl && (
                      <a class="store-btn" href={p.data.appStoreUrl} target="_blank" rel="noopener noreferrer" aria-label={`Download ${p.data.name} on the App Store`}>
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.365 1.43c0 1.14-.42 2.06-1.26 2.94-.94.98-2.06 1.55-3.22 1.44-.1-1.08.42-2.2 1.26-3.06.9-.9 2.2-1.4 3.22-1.32zM20.6 17.06c-.5 1.14-.74 1.66-1.38 2.68-.9 1.42-2.16 3.2-3.72 3.22-1.4.02-1.76-.92-3.66-.9-1.9.02-2.3.92-3.7.9-1.56-.02-2.76-1.62-3.66-3.04-2.52-3.9-2.78-8.48-1.24-10.92 1.1-1.72 2.86-2.74 4.5-2.74 1.68 0 2.74.94 4.12.94 1.34 0 2.16-.94 4.12-.94 1.44 0 2.98.78 4.06 2.14-3.58 1.96-3 7.1.56 8.66z"/></svg>
                        <span class="store-text"><span class="small">Download on the</span><span class="big">App Store</span></span>
                      </a>
                    )}
                    {p.data.playStoreUrl && (
                      <a class="store-btn" href={p.data.playStoreUrl} target="_blank" rel="noopener noreferrer" aria-label={`Get ${p.data.name} on Google Play`}>
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 2.6c-.4.4-.6.9-.6 1.5v15.8c0 .6.2 1.1.6 1.5l.1.1L13 12l-9.3-9.5-.1.1zM16 8.6l-2.6-1.5-3.9 3.9 3.9 3.9L16 13.4c1.1-.65 1.1-2.15 0-2.8zM4.4 21.4c.3.15.7.1 1-.1l9-5.2-2.6-2.6-7.4 7.9zM14.4 6.9L5.4 1.7c-.3-.2-.7-.25-1-.1l7.4 7.9 2.6-2.6z"/></svg>
                        <span class="store-text"><span class="small">Get it on</span><span class="big">Google Play</span></span>
                      </a>
                    )}
                  </div>
                )}
              </div>
              <div class={`stamp ${stampClass(p.data.status)}`}>{p.data.status}</div>
            </article>
          ))}
        </div>
      </section>
    )}

    {b.kind === 'bench' && (
      <section id="bench" class="bench">
        <div class="wrap">
          {home.bench.eyebrow && <div class="eyebrow">{home.bench.eyebrow}</div>}
          {home.bench.title && (
            <h2 class="section-title" style="font-size:clamp(20px,2.6vw,26px)">{home.bench.title}</h2>
          )}
          <div class="bench-grid">
            {benchRendered.map(p => (
              <div class="bench-card">
                <span class="b-tag">{p.data.fileNo} · {p.data.status}</span>
                <h4>{p.data.name}</h4>
                <div class="b-desc"><p.Content /></div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {b.kind === 'about' && (
      <section id="about" style="padding-top:40px">
        <div class="about">
          <div class="wrap" style="padding:0">
            {home.about.eyebrow && <div class="eyebrow">{home.about.eyebrow}</div>}
            {home.about.title && <h2 class="section-title">{home.about.title}</h2>}
            {home.about.body && <div class="about-body" set:html={md(home.about.body)} />}
            {(home.about.principles ?? []).length > 0 && (
              <div class="principles">
                {home.about.principles.map((pr: any) => (
                  <div class="principle">
                    {pr.key && <span class="key">{pr.key}</span>}
                    <h4>{pr.title}</h4>
                    <div set:html={md(pr.body)} />
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    {b.kind === 'contact' && (
      <section id="contact">
        <div class="wrap">
          <div class:list={['contact-card', { 'contact-card-form': home.contact.mode !== 'button' }]}>
            <div class="contact-copy">
              {home.contact.title && <h2>{home.contact.title}</h2>}
              {home.contact.body && <p set:html={mdInline(home.contact.body)} />}
            </div>
            {home.contact.mode === 'button'
              ? (home.contact.buttonLabel && home.contact.buttonUrl && (
                  <a class="btn btn-primary" href={home.contact.buttonUrl}>{home.contact.buttonLabel}</a>
                ))
              : <ContactForm form={home.contact.form} />}
          </div>
        </div>
      </section>
    )}

    {b.kind === 'custom' && <CustomSection section={(b as any).section} />}
  </Fragment>
))}

<script is:inline>
  // Netlify Identity sends invite/recovery tokens to the site root.
  // Forward them to /admin so Decap CMS can process the token.
  if (window.location.hash && window.location.hash.includes('_token=')) {
    window.location.href = '/admin/' + window.location.hash;
  }
</script>

</Base>

<style is:global>
header.hero{padding:84px 0 64px;position:relative;overflow:hidden}
.street-sign{display:inline-flex;align-items:stretch;border-radius:10px;overflow:hidden;box-shadow:0 10px 30px rgba(14,122,79,.28),inset 0 0 0 3px rgba(255,255,255,.85),inset 0 0 0 6px var(--sign-green-dark);background:var(--sign-green);color:#fff;margin-bottom:34px;transform:rotate(-1.2deg)}
.street-sign .sign-main{padding:14px 26px 12px;font-family:var(--font-display);font-weight:800;font-size:clamp(22px,4vw,34px);letter-spacing:.04em;text-transform:uppercase;line-height:1}
.street-sign .sign-main small{display:block;font-family:var(--font-mono);font-weight:500;font-size:11px;letter-spacing:.3em;margin-top:6px;opacity:.85}
.street-sign .sign-tab{background:var(--sign-green-dark);display:flex;align-items:center;padding:0 16px;font-family:var(--font-mono);font-size:12px;letter-spacing:.15em;border-left:2px solid rgba(255,255,255,.5)}
.hero h1{font-family:var(--font-display);font-weight:700;font-size:clamp(34px,5.6vw,58px);line-height:1.08;letter-spacing:-.015em;max-width:15ch;margin-bottom:22px}
.hero h1 em{font-style:normal;color:var(--sign-green)}
.hero p.lede{font-size:18px;color:var(--ink-soft);max-width:54ch;margin-bottom:34px}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap}
.hero-coords{position:absolute;right:24px;top:96px;font-family:var(--font-mono);font-size:11px;color:var(--ink-soft);text-align:right;letter-spacing:.08em;line-height:2;opacity:.7}
@media(max-width:760px){.hero-coords{display:none}}

section{padding:72px 0}
.section-intro{color:var(--ink-soft);max-width:60ch;margin-bottom:44px}

.product{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:34px 36px;display:grid;grid-template-columns:120px 1fr auto;gap:30px;align-items:start;margin-bottom:18px;position:relative;transition:box-shadow .2s ease,transform .2s ease}
.product:hover{box-shadow:0 14px 36px rgba(21,33,47,.10);transform:translateY(-2px)}
.product .file-no{font-family:var(--font-mono);font-size:12px;color:var(--ink-soft);letter-spacing:.1em;line-height:1.9}
.product .file-no b{display:block;font-size:30px;font-weight:600;color:var(--ink);letter-spacing:0}
.product .title-row{display:flex;align-items:center;gap:12px;margin-bottom:8px}
.product .logo{width:40px;height:40px;border-radius:9px;object-fit:cover;border:1px solid var(--line);background:var(--porcelain);flex-shrink:0}
.product h3{font-family:var(--font-display);font-weight:700;font-size:26px;letter-spacing:-.01em}
.product .tagline{font-family:var(--font-mono);font-size:12.5px;color:var(--sign-green);letter-spacing:.04em;margin-bottom:14px}
.product .desc{color:var(--ink-soft);font-size:15.5px;max-width:62ch}
.product ul.feats{margin:18px 0 0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:8px}
.product ul.feats li{font-size:12.5px;font-weight:500;background:var(--porcelain);border:1px solid var(--line);padding:5px 12px;border-radius:99px;color:var(--ink-soft)}
.store-ctas{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
.store-btn{display:inline-flex;align-items:center;gap:9px;background:var(--ink);color:#fff;text-decoration:none;padding:9px 16px 9px 14px;border-radius:9px;font-size:12.5px;line-height:1.25;transition:transform .15s ease,opacity .15s ease}
.store-btn:hover{transform:translateY(-2px);opacity:.92}
.store-btn svg{width:18px;height:18px;flex-shrink:0}
.store-btn .store-text{display:flex;flex-direction:column}
.store-btn .store-text .small{font-size:9.5px;letter-spacing:.03em;opacity:.75;text-transform:uppercase}
.store-btn .store-text .big{font-size:13.5px;font-weight:600}
.stamp{font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;padding:8px 14px;border-radius:6px;border:2px solid;transform:rotate(2deg);white-space:nowrap;justify-self:end}
.stamp.production{color:var(--sign-green-dark);border-color:var(--sign-green);background:rgba(14,122,79,.07)}
.stamp.prototype{color:var(--proto-blue);border-color:var(--proto-blue);background:rgba(38,96,164,.07)}
.stamp.dev{color:#9a6a08;border-color:var(--tape-amber);background:rgba(232,160,32,.09)}
@media(max-width:820px){.product{grid-template-columns:1fr;gap:14px}.product .file-no b{display:inline;font-size:18px;margin-right:8px}.stamp{justify-self:start;transform:rotate(0)}}

.bench{padding-top:8px}
.bench-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}
.bench-card{background:transparent;border:1.5px dashed var(--line);border-radius:var(--radius);padding:20px 22px}
.bench-card h4{font-family:var(--font-display);font-weight:600;font-size:17px;margin:8px 0 4px}
.bench-card .b-tag{font-family:var(--font-mono);font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft)}
.bench-card .b-desc{font-size:13.5px;color:var(--ink-soft)}
.bench-card .b-desc p{margin:0}

.about{background:var(--ink);color:#e8edf2;border-radius:20px;padding:60px 56px;margin:0 24px}
@media(max-width:640px){.about{padding:40px 26px;margin:0 12px}}
.about .eyebrow{color:var(--tape-amber)}
.about .eyebrow::after{background:rgba(255,255,255,.18)}
.about h2{color:#fff}
.about .about-body{color:#aebccb;max-width:64ch}
.about .about-body p{margin-bottom:14px}
.about .about-body p:last-child{margin-bottom:0}
.about .about-body a{color:var(--tape-amber)}
.about .principles{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:26px;margin-top:42px}
.about .principle h4{font-family:var(--font-display);font-weight:600;font-size:17px;color:#fff;margin-bottom:6px}
.about .principle p{font-size:14px;color:#aebccb}
.about .principle .key{font-family:var(--font-mono);font-size:11px;letter-spacing:.16em;color:var(--tape-amber);display:block;margin-bottom:8px}

.contact-card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:46px;display:flex;flex-wrap:wrap;gap:30px;align-items:center;justify-content:space-between}
.contact-card h2{font-family:var(--font-display);font-weight:700;font-size:clamp(24px,3vw,32px);margin-bottom:8px}
.contact-card p{color:var(--ink-soft);max-width:44ch}
.contact-card-form{display:grid;grid-template-columns:minmax(280px,0.85fr) minmax(320px,1.15fr);gap:44px;align-items:start}
.contact-card-form .contact-copy{position:sticky;top:88px}
@media(max-width:860px){.contact-card-form{grid-template-columns:1fr;gap:32px}.contact-card-form .contact-copy{position:static}}
@media(max-width:640px){.contact-card{padding:30px 24px}}
</style>
