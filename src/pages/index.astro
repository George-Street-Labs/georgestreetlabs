---
import { getCollection } from 'astro:content';

const all = (await getCollection('products'))
  .filter(p => p.data.visible)
  .sort((a, b) => a.data.order - b.data.order);

const liveProducts = all.filter(p => p.data.live);
const bench = all.filter(p => !p.data.live);

const rendered = await Promise.all(
  liveProducts.map(async p => ({ ...p, Content: (await p.render()).Content }))
);
const benchRendered = await Promise.all(
  bench.map(async p => ({ ...p, Content: (await p.render()).Content }))
);

const stampClass = (s) =>
  s === 'Production' || s === 'Beta' ? 'production'
  : s === 'Prototype' ? 'prototype'
  : 'dev';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>George Street Labs — A product workshop</title>
<meta name="description" content="George Street Labs is a small product studio. Our flagship, ArtView Privé, presents your art collection like a private gallery — local-first and museum-grade.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#15212f; --ink-soft:#3c4a5c; --porcelain:#f2f4f6; --paper:#fff;
  --sign-green:#0e7a4f; --sign-green-dark:#0a5c3c; --tape-amber:#e8a020;
  --line:#d6dce3; --proto-blue:#2660a4; --radius:14px;
  --font-display:"Bricolage Grotesque",system-ui,sans-serif;
  --font-body:"Inter",system-ui,sans-serif;
  --font-mono:"IBM Plex Mono",ui-monospace,monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}}
body{font-family:var(--font-body);color:var(--ink);background:var(--porcelain);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
:focus-visible{outline:3px solid var(--tape-amber);outline-offset:2px;border-radius:4px}

nav{position:sticky;top:0;z-index:50;background:rgba(242,244,246,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;height:64px}
.nav-brand{font-family:var(--font-mono);font-weight:600;font-size:14px;letter-spacing:.06em;text-decoration:none;display:flex;align-items:center;gap:10px}
.nav-brand .dot{width:10px;height:10px;border-radius:3px;background:var(--sign-green);display:inline-block}
.nav-links{display:flex;gap:26px;font-size:14px;font-weight:500}
.nav-links a{text-decoration:none;color:var(--ink-soft)}
.nav-links a:hover{color:var(--ink)}
@media(max-width:640px){.nav-links{gap:16px;font-size:13px}}

header.hero{padding:84px 0 64px;position:relative;overflow:hidden}
.street-sign{display:inline-flex;align-items:stretch;border-radius:10px;overflow:hidden;box-shadow:0 10px 30px rgba(14,122,79,.28),inset 0 0 0 3px rgba(255,255,255,.85),inset 0 0 0 6px var(--sign-green-dark);background:var(--sign-green);color:#fff;margin-bottom:34px;transform:rotate(-1.2deg)}
.street-sign .sign-main{padding:14px 26px 12px;font-family:var(--font-display);font-weight:800;font-size:clamp(22px,4vw,34px);letter-spacing:.04em;text-transform:uppercase;line-height:1}
.street-sign .sign-main small{display:block;font-family:var(--font-mono);font-weight:500;font-size:11px;letter-spacing:.3em;margin-top:6px;opacity:.85}
.street-sign .sign-tab{background:var(--sign-green-dark);display:flex;align-items:center;padding:0 16px;font-family:var(--font-mono);font-size:12px;letter-spacing:.15em;border-left:2px solid rgba(255,255,255,.5)}
.hero h1{font-family:var(--font-display);font-weight:700;font-size:clamp(34px,5.6vw,58px);line-height:1.08;letter-spacing:-.015em;max-width:15ch;margin-bottom:22px}
.hero h1 em{font-style:normal;color:var(--sign-green)}
.hero p.lede{font-size:18px;color:var(--ink-soft);max-width:54ch;margin-bottom:34px}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:15px;text-decoration:none;padding:13px 24px;border-radius:10px;transition:transform .15s ease,box-shadow .15s ease}
.btn-primary{background:var(--ink);color:#fff;box-shadow:0 4px 14px rgba(21,33,47,.25)}
.btn-primary:hover{transform:translateY(-2px)}
.btn-ghost{border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}
.btn-ghost:hover{border-color:var(--ink-soft)}
.hero-coords{position:absolute;right:24px;top:96px;font-family:var(--font-mono);font-size:11px;color:var(--ink-soft);text-align:right;letter-spacing:.08em;line-height:2;opacity:.7}
@media(max-width:760px){.hero-coords{display:none}}

section{padding:72px 0}
.eyebrow{font-family:var(--font-mono);font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--sign-green);margin-bottom:14px;display:flex;align-items:center;gap:12px}
.eyebrow::after{content:"";flex:1;max-width:80px;height:1px;background:var(--line)}
.section-title{font-family:var(--font-display);font-weight:700;font-size:clamp(26px,3.6vw,38px);letter-spacing:-.01em;margin-bottom:14px}
.section-intro{color:var(--ink-soft);max-width:60ch;margin-bottom:44px}

.product{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:34px 36px;display:grid;grid-template-columns:120px 1fr auto;gap:30px;align-items:start;margin-bottom:18px;position:relative;transition:box-shadow .2s ease,transform .2s ease}
.product:hover{box-shadow:0 14px 36px rgba(21,33,47,.10);transform:translateY(-2px)}
.product .file-no{font-family:var(--font-mono);font-size:12px;color:var(--ink-soft);letter-spacing:.1em;line-height:1.9}
.product .file-no b{display:block;font-size:30px;font-weight:600;color:var(--ink);letter-spacing:0}
.product h3{font-family:var(--font-display);font-weight:700;font-size:26px;margin-bottom:8px;letter-spacing:-.01em}
.product .tagline{font-family:var(--font-mono);font-size:12.5px;color:var(--sign-green);letter-spacing:.04em;margin-bottom:14px}
.product .desc{color:var(--ink-soft);font-size:15.5px;max-width:62ch}
.product ul.feats{margin:18px 0 0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:8px}
.product ul.feats li{font-size:12.5px;font-weight:500;background:var(--porcelain);border:1px solid var(--line);padding:5px 12px;border-radius:99px;color:var(--ink-soft)}
.stamp{font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;padding:8px 14px;border-radius:6px;border:2px solid;transform:rotate(2deg);white-space:nowrap;justify-self:end}
.stamp.production{color:var(--sign-green-dark);border-color:var(--sign-green);background:rgba(14,122,79,.07)}
.stamp.prototype{color:var(--proto-blue);border-color:var(--proto-blue);background:rgba(38,96,164,.07)}
.stamp.dev{color:#9a6a08;border-color:var(--tape-amber);background:rgba(232,160,32,.09)}
@media(max-width:820px){.product{grid-template-columns:1fr;gap:14px}.product .file-no b{display:inline;font-size:18px;margin-right:8px}.stamp{justify-self:start;transform:rotate(0)}}

/* On the bench — small, deliberately quiet */
.bench{padding-top:8px}
.bench-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}
.bench-card{background:transparent;border:1.5px dashed var(--line);border-radius:var(--radius);padding:20px 22px}
.bench-card h4{font-family:var(--font-display);font-weight:600;font-size:17px;margin:8px 0 4px}
.bench-card .b-tag{font-family:var(--font-mono);font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft)}
.bench-card .b-desc{font-size:13.5px;color:var(--ink-soft)}
.bench-card .b-desc p{margin:0}

.about{background:var(--ink);color:#e8edf2;border-radius:20px;padding:60px 56px;margin:0 24px}
@media(max-width:640px){.about{padding:40px 26px;margin:0 12px}}
.about .eyebrow{color:var(--tape-amber)}
.about .eyebrow::after{background:rgba(255,255,255,.18)}
.about h2{color:#fff}
.about p{color:#aebccb;max-width:64ch}
.about .principles{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:26px;margin-top:42px}
.about .principle h4{font-family:var(--font-display);font-weight:600;font-size:17px;color:#fff;margin-bottom:6px}
.about .principle p{font-size:14px}
.about .principle .key{font-family:var(--font-mono);font-size:11px;letter-spacing:.16em;color:var(--tape-amber);display:block;margin-bottom:8px}

.contact-card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:46px;display:flex;flex-wrap:wrap;gap:30px;align-items:center;justify-content:space-between}
.contact-card h2{font-family:var(--font-display);font-weight:700;font-size:clamp(24px,3vw,32px);margin-bottom:8px}
.contact-card p{color:var(--ink-soft);max-width:44ch}

footer{border-top:1px solid var(--line);padding:36px 0 48px;font-size:13px;color:var(--ink-soft)}
.foot-inner{display:flex;flex-wrap:wrap;gap:18px;justify-content:space-between;align-items:center}
.foot-inner .mono{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em}
</style>
</head>
<body>

<nav>
  <div class="wrap nav-inner">
    <a class="nav-brand" href="#top"><span class="dot" aria-hidden="true"></span>GEORGE&nbsp;STREET&nbsp;LABS</a>
    <div class="nav-links">
      <a href="#products">Products</a>
      <a href="#bench">The bench</a>
      <a href="#about">Studio</a>
      <a href="#contact">Contact</a>
    </div>
  </div>
</nav>

<header class="hero" id="top">
  <div class="wrap">
    <div class="street-sign" role="img" aria-label="George Street Labs street sign">
      <div class="sign-main">George St<small>L&nbsp;A&nbsp;B&nbsp;S</small></div>
      <div class="sign-tab">EST.&nbsp;2026</div>
    </div>
    <h1>Apps built for <em>real life</em>, not just screens.</h1>
    <p class="lede">George Street Labs is a small product workshop. We take ideas from sketch to shipped — starting with ArtView Privé, a private gallery for the art you actually own.</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#products">See what we're building →</a>
      <a class="btn btn-ghost" href="#contact">Work with us</a>
    </div>
  </div>
  <div class="hero-coords" aria-hidden="true">
    CHICAGO, IL<br>41.8781° N, 87.6298° W<br>FILE STATUS: ACTIVE
  </div>
</header>

<section id="products">
  <div class="wrap">
    <div class="eyebrow">Project files</div>
    <h2 class="section-title">The product lineup</h2>
    <p class="section-intro">Everything starts as a lab file. The ones that earn their stamp go to production. Here's what's on the board now.</p>

    {rendered.map(p => (
      <article class="product">
        <div class="file-no"><b>{String(p.data.order).padStart(2,'0')}</b>FILE {p.data.fileNo}</div>
        <div>
          <h3>{p.data.name}</h3>
          <div class="tagline">{p.data.tagline}</div>
          <div class="desc"><p.Content /></div>
          {p.data.features.length > 0 && (
            <ul class="feats">{p.data.features.map(f => <li>{f}</li>)}</ul>
          )}
        </div>
        <div class={`stamp ${stampClass(p.data.status)}`}>{p.data.status}</div>
      </article>
    ))}
  </div>
</section>

{benchRendered.length > 0 && (
<section id="bench" class="bench">
  <div class="wrap">
    <div class="eyebrow">On the bench</div>
    <h2 class="section-title" style="font-size:clamp(20px,2.6vw,26px)">Ideas in the lab — not yet released</h2>
    <div class="bench-grid">
      {benchRendered.map(p => (
        <div class="bench-card">
          <span class="b-tag">{p.data.fileNo} · {p.data.status}</span>
          <h4>{p.data.name}</h4>
          <div class="b-desc"><p.Content /></div>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<section id="about" style="padding-top:40px">
  <div class="about">
    <div class="wrap" style="padding:0">
      <div class="eyebrow">The studio</div>
      <h2 class="section-title">Small lab. Shipped products.</h2>
      <p>We're a product studio that builds the whole thing — concept, design, engineering, and the unglamorous work of actually launching. We keep the lab small on purpose: fewer meetings, more shipping.</p>
      <div class="principles">
        <div class="principle"><span class="key">PRINCIPLE 01</span><h4>Private where it counts</h4><p>When the data is personal — your collection, your messages, your plans — it should live on your hardware, not our servers.</p></div>
        <div class="principle"><span class="key">PRINCIPLE 02</span><h4>No friction by default</h4><p>QR codes over downloads. An email over an account. If someone can't be using it in ten seconds, it's not done.</p></div>
        <div class="principle"><span class="key">PRINCIPLE 03</span><h4>Excellent over average</h4><p>When there's a choice between "it works" and "it's crafted," we choose crafted — and say so honestly when something isn't ready.</p></div>
      </div>
    </div>
  </div>
</section>

<section id="contact">
  <div class="wrap">
    <div class="contact-card">
      <div>
        <h2>Have a product that belongs on the board?</h2>
        <p>We partner with collectors, galleries, founders, and teams who want something built well. Tell us what you're imagining.</p>
      </div>
      <a class="btn btn-primary" href="mailto:hello@georgestreetlabs.com">hello@georgestreetlabs.com</a>
    </div>
  </div>
</section>

<footer>
  <div class="wrap foot-inner">
    <div class="mono">GEORGE STREET LABS — FILE STATUS: ACTIVE</div>
    <div>© 2026 George Street Labs LLC. All rights reserved.</div>
  </div>
</footer>

</body>
</html>
